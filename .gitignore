# 进度数据库（用户数据；本仓库是公开的，这类数据一律不进 git）
# 默认落在仓库外的 JunEnglish/data/englishforge/，这里再兜一道底。
# 必须带前导斜杠锚到仓库根：写成 data/ 会把 src/data/（课程题库源码）一起忽略掉 ——
# 新增的题目文件会静默进不了 git（本条正是被这个坑到才加的注释）
/data/
*.db
*.db-wal
*.db-shm

# NAS 生产部署（deploy/production/.env 含真实密钥，绝不进 git）
deploy/production/

# 版本化发布包（scripts/release.mjs 生成；每版一个 git 短哈希目录）
releases/

# TTS 管线的临时 PowerShell 脚本
scripts/.tmp-tts.ps1

# TTS 段级缓存（Qwen3-TTS，按 model|voice|text 哈希）
scripts/.tts-cache/

