# 复制为 deploy/production/.env 并按 NAS 实际情况修改（本机 192.168.31.246 已核实的值如下）。
# deploy/production/ 整个目录已 gitignore —— 密钥只写在那份 .env 里，不进 git。

# 局域网访问端口（2026-09-29 核实 4173 空闲；与本地开发习惯一致）
ENGLISHFORGE_PORT=4173

# NAS 的局域网 IP
NAS_IP=192.168.31.246

# 当前运行的版本标签（git 短哈希；nas-update.sh 会自动改写这一行）
ENGLISHFORGE_TAG=latest

# 容器内运行身份 = 共享目录属主（zaxchou uid=1026, users gid=100，已核实）
CONTAINER_UID=1026
CONTAINER_GID=100

# 生产数据库目录（NAS 本机真实路径；englishforge-production 子目录挂进容器 /app/data）
DATA_DIR=/volume2/Media/BaiduNetdiskWorkspace/myagent-work/zcode/JunEnglish/data

# ---- 模型密钥（出题 = DeepSeek；审核/改稿 = MiMo。留空 = 对应能力关闭，界面会如实显示）----
# 与 molin-wiki/backend/.env 同源；首次部署时由脚本从那边读来写入，也可手工填
DEEPSEEK_API_KEY=
AI_API_KEY=
AI_BASE_URL=https://api.xiaomimimo.com/v1
AI_MODEL=mimo-v2.6-flash
